# Neon
DATABASE_URL=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Neon Auth
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Vercel Blob (Vercel Dashboard → Storage → Blob → read/write token) — image uploads only
BLOB_READ_WRITE_TOKEN=

# Google Gemini (free) — https://aistudio.google.com/apikey — photo + URL AI fallback
GOOGLE_GENERATIVE_AI_API_KEY=

# Set to 1 to never use r.jina.ai when a site returns 403 (e.g. Allrecipes blocks server IPs)
# IMPORT_DISABLE_JINA=1

# Optional overrides (see src/lib/llm-recipe-fallback.ts)
# GEMINI_TEXT_MODEL=gemini-3.1-flash-lite
# GEMINI_VISION_MODEL=gemini-3.1-flash-lite
